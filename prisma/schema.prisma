// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTHENTICATION (Better Auth) ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  accounts  Account[]
  orders    Order[]
  addresses Address[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// Better Auth rate limiting (when rateLimit.storage: "database")
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  lastRequest BigInt   @default(0)

  @@map("rateLimit")
}

// ==================== ATTRIBUTES ====================

model Attribute {
  id        String   @id @default(cuid())
  name      String   @unique // "Color", "Size", "Material"
  slug      String   @unique // "color", "size", "material"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values   AttributeValue[]
  products ProductAttribute[]

  @@index([slug])
}

model AttributeValue {
  id           String   @id @default(cuid())
  attributeId  String
  value        String   // "black", "xl"
  displayValue String   // "Black", "XL"
  metadata     Json?    // { hex: "#000000" } for colors
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attribute       Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants        VariantAttributeValue[]
  productValues   ProductAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
}

// ==================== PRODUCTS ====================

enum ProductType {
  SIMPLE   // Single price and stock; attributes optional (display only)
  VARIABLE // Attributes generate variants with own stock/price/SKU
}

model Product {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  description    String?     @db.Text
  regularPrice   Decimal     @db.Decimal(10, 2)
  salePrice      Decimal?    @db.Decimal(10, 2)
  images         String[]
  // Legacy fields - kept for backward compatibility during migration
  colors         String[]    @default([])
  sizes          String[]    @default([])
  stock          Int         @default(0)
  // Product type (WooCommerce-style: Simple vs Variable)
  productType    ProductType @default(SIMPLE)
  trackInventory Boolean     @default(false) // Derived from productType in app (Variable => true)
  isFeatured     Boolean     @default(false)
  isActive       Boolean     @default(true)
  sizeChart      Json?

  // ---- SEO (all optional; the storefront falls back to title/description) ----
  metaTitle       String? // <title> override, ~60 chars
  metaDescription String? // meta description override, ~160 chars
  canonicalUrl    String? // absolute URL, only for intentional duplicates

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  categoryId String?
  category   Category?          @relation("ProductCategoryLegacy", fields: [categoryId], references: [id])
  categories ProductCategory[]
  attributes ProductAttribute[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  relatedProducts         ProductRelatedProduct[] @relation("ProductRelated")
  relatedProductsAsRelated ProductRelatedProduct[] @relation("RelatedToProduct")
  reviews                  ReviewProduct[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductRelatedProduct {
  id               String  @id @default(cuid())
  productId        String
  relatedProductId String
  sortOrder        Int     @default(0)

  product        Product @relation("ProductRelated", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedToProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
}

model ProductAttribute {
  id          String @id @default(cuid())
  productId   String
  attributeId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  // Selected values for this product's attribute
  selectedValues ProductAttributeValue[]

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}

model ProductAttributeValue {
  id                 String @id @default(cuid())
  productAttributeId String
  attributeValueId   String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue   @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productAttributeId, attributeValueId])
  @@index([productAttributeId])
  @@index([attributeValueId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String?
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2) // Optional price override
  images    String[] @default([])
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes     VariantAttributeValue[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([sku])
}

model VariantAttributeValue {
  id               String @id @default(cuid())
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
}

// Audit log for stock changes - helps identify discrepancies
model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  variantId   String?   // null = simple product
  delta       Int      // negative = deduct, positive = restore
  reason      String   // ORDER_CREATED | ORDER_CANCELLED | ORDER_DELETED | PAYMENT_REJECTED | MANUAL_EDIT | ORDER_REACTIVATED
  orderId     String?
  orderNumber String?
  createdAt   DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  description String?
  image     String?

  // ---- SEO (all optional; falls back to name/description) ----
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  parentId  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  products Product[]  @relation("ProductCategoryLegacy")
  productCategories ProductCategory[]

  @@index([slug])
  @@index([isActive])
  @@index([parentId])
}

// Many-to-many relationship between Product and Category
model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

// ==================== ORDERS ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?

  // Contact Information
  customerName  String
  customerEmail String?
  customerPhone String

  // Shipping Address
  shippingAddress String @db.Text
  city            String
  altPhone        String?
  deliveryNote    String?

  // Order Details
  shippingCost   Decimal     @db.Decimal(10, 2)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal?    @db.Decimal(10, 2) // Coupon discount applied
  total          Decimal     @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING)

  // Optional coupon used at checkout
  couponId String?

  // Payment Information
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  senderNumber  String?       // Customer's mobile money number
  transactionId String?       // Transaction reference from mobile payment
  paidAt        DateTime?     // When payment was verified

  // Courier fraud check (BDCourier API) - cached result, refreshed manually
  courierCheckData     Json?      // { status, data?: { phone, couriers }, error?: string }
  courierCheckCheckedAt DateTime? // When the check was last run

  // Client IP for cooldown and IP ban (best-effort; x-forwarded-for can be spoofed)
  clientIp     String?

  // Traffic attribution (best-effort, captured client-side; null for pre-feature orders)
  sourceChannel      String?  // normalized last-touch channel, e.g. "facebook"
  firstSourceChannel String?  // normalized first-touch channel
  attribution        Json?    // { first: TouchData | null, last: TouchData | null }

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user            User?             @relation(fields: [userId], references: [id])
  coupon          Coupon?           @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  stockMovements  StockMovement[]
  promotion       OrderPromotion?

  @@index([userId])
  @@index([couponId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([sourceChannel])
  // Customer history lookups ("times purchased", search). Both already exist in the live DB:
  // the phone index from 20260421000000_add_banned_phone, the email index built CONCURRENTLY
  // on 2026-09-25; the matching migration uses IF NOT EXISTS so it is a no-op there.
  @@index([customerPhone])
  @@index([customerEmail])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  color     String
  size      String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ==================== COUPONS ====================

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. SAVE10
  type      CouponType @default(PERCENT) // PERCENT or FIXED
  value     Decimal  @db.Decimal(10, 2) // percentage 1-100 or fixed BDT amount
  minOrderAmount Decimal? @db.Decimal(10, 2) // minimum order to use (optional)
  maxUses   Int?     // null = unlimited
  usedCount Int      @default(0)
  validFrom DateTime?
  validUntil DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([code])
  @@index([isActive])
}

// ==================== AUTOMATIC OFFERS ====================
// "Spend X, get Y" discounts applied at checkout without a code. Kept in their own tables
// (not columns on Coupon) so the code runs safely even before this migration is applied.

model Promotion {
  id             String     @id @default(cuid())
  name           String     // shown to customers, e.g. "Eid offer"
  type           CouponType @default(PERCENT)
  value          Decimal    @db.Decimal(10, 2) // percent 0-100 or fixed BDT; 0 allowed with free delivery
  minOrderAmount Decimal    @db.Decimal(10, 2) // subtotal needed to unlock the offer
  maxDiscount    Decimal?   @db.Decimal(10, 2) // optional cap for percentage offers
  freeShipping   Boolean    @default(false)
  isActive       Boolean    @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  // Payment methods the offer is valid for; empty = every method (e.g. [BKASH, NAGAD, ROCKET] = not COD)
  allowedPaymentMethods PaymentMethod[] @default([])
  usedCount      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders OrderPromotion[]

  @@index([isActive])
}

// The offer applied to an order, with its name and amounts frozen at the time of purchase.
model OrderPromotion {
  orderId        String   @id
  promotionId    String?
  name           String
  discountAmount Decimal  @db.Decimal(10, 2)
  freeShipping   Boolean  @default(false)
  createdAt      DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([promotionId])
}

enum CouponType {
  PERCENT
  FIXED
}

// ==================== USER DATA ====================

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  address   String   @db.Text
  city      String
  altPhone  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== CUSTOMER REVIEWS (screenshots) ====================

enum ReviewSource {
  MESSENGER
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  PHOTO
  OTHER
}

// A customer screenshot shown on the home page, /reviews and product Reviews tab.
model Review {
  id           String       @id @default(cuid())
  image        String       // ImageKit URL (or /reviews/... for the originally seeded files)
  width        Int          // natural pixel size, for layout without shifting
  height       Int
  caption      String       @default("") // not shown; alt text for screen readers and SEO
  customerName String       @default("")
  /**
   * Star rating 1-5 transcribed from the customer's message by an admin.
   * Nullable: existing screenshots have no rating, and a product only gets
   * AggregateRating markup once real ratings exist.
   */
  rating       Int?
  source       ReviewSource @default(MESSENGER)
  isFeatured   Boolean      @default(false) // home page + product-tab fallback
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products ReviewProduct[]

  @@index([isActive, sortOrder])
}

// Screenshots tagged to specific products (shown first in that product's Reviews tab).
model ReviewProduct {
  reviewId  String
  productId String

  review  Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([reviewId, productId])
  @@index([productId])
}

// ==================== HERO SLIDER ====================

model HeroSlide {
  id        String   @id @default(cuid())
  image    String   // URL or path, e.g. /uploads/xxx.jpg or /sliderimagepolo.png
  alt      String   @default("")
  link     String?  // Optional click-through URL
  sortOrder Int     @default(0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ==================== CITIES (Delivery Areas) ====================

enum ShippingZone {
  inside_dhaka
  outside_dhaka
}

model City {
  id           String       @id @default(cuid())
  name         String       // Display name e.g. "Dhaka", "Dhanmondi"
  value        String       @unique // Slug for form value e.g. "dhaka", "dhanmondi"
  shippingZone ShippingZone // inside_dhaka or outside_dhaka - determines delivery rate
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([shippingZone])
}

// ==================== IP BANS (anti-spam) ====================

model BannedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([ipAddress])
}

// ==================== PHONE BANS (anti-spam) ====================

model BannedPhone {
  id          String   @id @default(cuid())
  phoneNumber String   @unique // stored normalized as 01XXXXXXXXX
  reason      String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}

// ==================== SETTINGS ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ==================== ENUMS ====================

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
